{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "hosting-redirect",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "LICENSE",
      "README.md"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://thankyouindoforthecleanair.pages.dev/",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://thankyouindoforthecleanair.pages.dev/:path",
        "type": 301
      }
    ]
  }
}
